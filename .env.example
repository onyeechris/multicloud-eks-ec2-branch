# ── Pulumi backend ────────────────────────────────────────────────────────────
# Option A: self-hosted state in S3 (recommended for production)
PULUMI_BACKEND_URL=s3://my-pulumi-state-bucket

# Option B: Pulumi Cloud (comment out PULUMI_BACKEND_URL and use this instead)
# Generate a token at: https://app.pulumi.com/account/tokens
# PULUMI_ACCESS_TOKEN=pul-xxxxxxxxxxxxxxxxxxxx

# Passphrase used to encrypt stack secrets at rest.
# Required when using a self-hosted backend. Set to empty string to disable encryption.
PULUMI_CONFIG_PASSPHRASE=change-me

# ── AWS credentials ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# ── Optional ──────────────────────────────────────────────────────────────────
# Slack notifications — create an Incoming Webhook at:
# https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# JWT signing key used to validate bearer tokens on every API route (generate a long random value)
jwt_secret_key=change-me-to-a-long-random-string
